{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bootstrap-sha": "662778fba54649580d16ae83f71b8d74b44a9d78",
  "packages": {
    ".": {
      "package-name": "tasteful-todo",
      "component": "tasteful-todo",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"app\")].version"
        }
      ]
    }
  }
}
